# Read docs/deployment.md and docs/privacy-boundaries.md first.
# Every blank secret is required for production and must be generated locally.
# Do not hand-write production secrets. Run scripts/bootstrap_production.py locally.
APP_ENV=development
APP_VERSION=0.2.0-rc.1
APP_TIMEZONE=Asia/Singapore

# PostgreSQL source of truth
POSTGRES_DB=shen
POSTGRES_USER=shen
POSTGRES_PASSWORD=
DATABASE_URL=

# Queue
REDIS_URL=redis://redis:6379/0
TASKS_EAGER=false
CELERY_RESULT_EXPIRES_SECONDS=604800

# Private content-addressed storage
STORAGE_BACKEND=local
STORAGE_ROOT=/app/data/storage
MAX_UPLOAD_BYTES=26214400

# Single-user authentication
APP_ADMIN_USERNAME=admin
# Development may use APP_ADMIN_PASSWORD. Production requires only a PBKDF2 hash.
APP_ADMIN_PASSWORD=
APP_ADMIN_PASSWORD_HASH=
JWT_SECRET=
JWT_EXPIRE_MINUTES=480

# PII protection. These two secrets must be different.
# Loss of PII_ENCRYPTION_SECRET can make PatientIdentity unrecoverable.
# Keep a recovery copy in a password manager; these two values must differ.
PII_ENCRYPTION_SECRET=
PII_HASH_SECRET=

# OCR: mock or mineru. MinerU sends the original file to a cloud privacy boundary.
OCR_PROVIDER=mock
MINERU_BASE_URL=https://mineru.net
MINERU_API_TOKEN=
MINERU_MODEL_VERSION=vlm
MINERU_LANGUAGE=ch
MINERU_POLL_INTERVAL_SECONDS=3
MINERU_TIMEOUT_SECONDS=300
# User-approved identifiable upload remains disabled until this explicit switch is true.
ALLOW_IDENTIFIABLE_MINERU_UPLOAD=false

# Browser/API origins
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://api:8000
NEXT_PUBLIC_APP_NAME=师承临床知识库
COOKIE_SECURE=false

# Production-only host paths. Keep clinical content outside development paths.
# The bootstrap workflow writes these to ignored .env.production.local.
PRODUCTION_DOCUMENT_STORAGE=
PRODUCTION_BACKUP_ROOT=
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=
# Optional absolute path to a trusted restic executable. Never commit the binary.
RESTIC_EXECUTABLE=


# Live clinical extraction can send IDENTIFIABLE OCR text. Explicit consent required.
AI_EXTRACTION_ENABLED=true
AI_EXTRACTION_PROVIDER=mock
AI_EXTRACTION_ALLOW_IDENTIFIABLE_INPUT=false
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_PROVIDER_MODEL=glm-4.7
AI_VERIFICATION_ENABLED=false

# Original-image verification is a separate explicit upload boundary.
AI_VISION_VERIFICATION_ENABLED=false
ALLOW_IDENTIFIABLE_AI_VISION_UPLOAD=false
AI_VISION_PROVIDER_API_KEY=
AI_VISION_PROVIDER_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_VISION_PROVIDER_MODEL=glm-4.6v

# Optional status display only; does not create a backup.
BACKUP_MANIFEST_DIR=
